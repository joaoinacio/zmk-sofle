#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 50  // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <600>;     // 300
    delay-ms = <50>;                  // 0
};

&mmv { time-to-max-speed-ms = <400>; };

&soft_off { hold-time-ms = <2000>; };

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <110>;
    require-prior-idle-ms = <(-1)>;
    tapping-term-ms = <220>;
};

&sk {
    quick-release;
    release-after-ms = <2000>;
};

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE SEMICOLON COLON MINUS>; };

/ {
    mt_h_R_slow: mt_h_R_slow {
        compatible = "zmk,behavior-hold-tap";
        label = "Home mod R (slow)";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <260>;
        require-prior-idle-ms = <150>;
        flavor = "tap-preferred";
        hold-trigger-key-positions = <13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44 53 54 55 56 57 59 60>;
        hold-trigger-on-release;
    };

    mt_h_L_slow: mt_h_L_slow {
        compatible = "zmk,behavior-hold-tap";
        label = "Home mod L (slow)";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <260>;
        require-prior-idle-ms = <150>;
        flavor = "tap-preferred";
        hold-trigger-key-positions = <59 60 59 56 57 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51 60 61 62 63>;
        hold-trigger-on-release;
    };

    mt_h_R: mt_h_R {
        compatible = "zmk,behavior-hold-tap";
        label = "Home mod R (shift)";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        require-prior-idle-ms = <100>;
        flavor = "tap-preferred";
        hold-trigger-key-positions = <13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44 53 54 55 56 57 59 60>;
        hold-trigger-on-release;
    };

    mt_h_L: mt_h_L {
        compatible = "zmk,behavior-hold-tap";
        label = "Home mod L (shift)";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        require-prior-idle-ms = <100>;
        flavor = "tap-preferred";
        hold-trigger-key-positions = <59 60 59 56 57 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51 60 61 62 63>;
        hold-trigger-on-release;
    };

    mt_sk: mt_sk {
        compatible = "zmk,behavior-hold-tap";
        label = "MT_SK";
        bindings = <&sk>, <&kp>;

        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <175>;
        require-prior-idle-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        sys {
            bindings = <&mo 1>;
            key-positions = <39 13>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none           &none                    &none                    &none                        &none                 &none        &msc SCRL_UP     &none      &none                  &none                    &none                    &none                       &none
&kp ESCAPE      &kp Q                    &kp W                    &kp E                        &kp R                 &kp T        &msc SCRL_DOWN   &kp Y      &kp U                  &kp I                    &kp O                    &kp P                       &kp BACKSLASH
&kp BACKSPACE   &mt_h_L_slow LEFT_GUI A  &mt_h_L_slow LEFT_ALT S  &mt_h_L_slow LEFT_CONTROL D  &mt_h_L LEFT_SHIFT F  &kp G        &msc SCRL_LEFT   &kp H      &mt_h_R RIGHT_SHIFT J  &mt_h_R_slow RCTRL K     &mt_h_R_slow LEFT_ALT L  &mt_h_R_slow LEFT_GUI SEMI  &kp APOS
&caps_word      &kp Z                    &kp X                    &kp C                        &kp V                 &kp B        &msc SCRL_RIGHT  &kp N      &kp M                  &mt_sk LEFT_SHIFT COMMA  &kp DOT                  &kp FSLH                    &none
&kp C_MUTE      &none                    &none                    &kp ESCAPE                   &kp TAB               &kp SPACE    &mkp LCLK        &kp ENTER  &kp DELETE             &kp RIGHT_ALT            &none                    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "base";
        };

        sys {
            bindings = <
&trans  &trans        &trans        &trans        &trans          &trans         &mmv MOVE_UP     &trans           &trans           &trans           &trans           &trans           &trans
&trans  &out OUT_USB  &out OUT_BLE  &trans        &trans          &bootloader    &mmv MOVE_DOWN   &bootloader      &trans           &trans           &trans           &trans           &trans
&trans  &trans        &trans        &trans        &mkp LCLK       &mkp RCLK      &mmv MOVE_LEFT   &rgb_ug RGB_ON   &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &trans
&trans  &trans        &trans        &msc SCRL_UP  &msc SCRL_DOWN  &trans         &mmv MOVE_RIGHT  &rgb_ug RGB_OFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &trans
&trans  &trans        &trans        &trans        &trans          &trans         &mkp LCLK        &trans           &trans           &trans           &trans           &trans
            >;

            label = "sys";
        };
    };
};
