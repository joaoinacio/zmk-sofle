#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 50  // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <600>;     // 300
    delay-ms = <50>;                  // 0
};

&mmv { time-to-max-speed-ms = <400>; };

&soft_off { hold-time-ms = <2000>; };

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <110>;
    require-prior-idle-ms = <(-1)>;
    tapping-term-ms = <220>;
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <(-1)>;
    flavor = "hold-preferred";
};

&sl { release-after-ms = <3000>; };

&sk {
    quick-release;
    release-after-ms = <2000>;
};

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE SEMICOLON COLON MINUS>; };

/ {
    mt_h_R_slow: mt_h_R_slow {
        compatible = "zmk,behavior-hold-tap";
        label = "Home mod R (slow)";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <260>;
        require-prior-idle-ms = <150>;
        flavor = "tap-preferred";
        hold-trigger-key-positions = <13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44 53 54 55 56 57 59 60>;
        hold-trigger-on-release;
    };

    mt_h_L_slow: mt_h_L_slow {
        compatible = "zmk,behavior-hold-tap";
        label = "Home mod L (slow)";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <260>;
        require-prior-idle-ms = <150>;
        flavor = "tap-preferred";
        hold-trigger-key-positions = <59 60 59 56 57 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51 60 61 62 63>;
        hold-trigger-on-release;
    };

    mt_h_R: mt_h_R {
        compatible = "zmk,behavior-hold-tap";
        label = "Home mod R (shift)";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <220>;
        flavor = "balanced";
        hold-trigger-key-positions = <13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44 53 54 55 56 57 59 60>;
        hold-trigger-on-release;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <120>;
    };

    mt_h_L: mt_h_L {
        compatible = "zmk,behavior-hold-tap";
        label = "Home mod L (shift)";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <220>;
        flavor = "balanced";
        hold-trigger-key-positions = <59 60 59 56 57 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51 60 61 62 63>;
        hold-trigger-on-release;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <120>;
    };

    alayer_caps_colem: alayer_caps_colem {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <UNDERSCORE BACKSPACE DELETE SEMICOLON COLON MINUS>;
        ignore-alphas;
        ignore-numbers;
        ignore-modifiers;
        label = "Caps word (Colemak O)";
    };

    alayer_nav: alayer_nav {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <LEFT RIGHT UP DOWN HOME END PAGE_UP PAGE_DOWN DELETE BACKSPACE INSERT>;
        ignore-modifiers;
        label = "Layer lock nav";
    };

    alayer_num: alayer_num {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <BACKSPACE DELETE DOT COMMA MINUS PLUS STAR FSLH EQUAL>;
        ignore-numbers;
        ignore-modifiers;
        label = "Layer lock num";
    };

    td_capsw_lock: td_capsw_lock {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <300>;
        bindings = <&capsw 5>, <&kp CAPSLOCK>;

        label = "Caps word / Caps lock";
    };

    mt_sk: mt_sk {
        compatible = "zmk,behavior-hold-tap";
        label = "MT_SK";
        bindings = <&sk>, <&kp>;

        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <175>;
        require-prior-idle-ms = <100>;
    };

    behaviors {
    };

    macros {
        kp_to: kp_to {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_2to1 &to MACRO_PLACEHOLDER>;
            label = "Tap key, to layer";
        };

        capsw: capsw {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&caps_word &macro_param_1to1 &alayer_caps_colem MACRO_PLACEHOLDER>;
            label = "Caps word + Colemak O";
        };
    };

    combos {
        compatible = "zmk,combos";

        sys {
            bindings = <&mo 4>;
            key-positions = <13 26>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none                 &none                    &none                    &none                        &none                 &none        &msc SCRL_UP     &none      &none                  &none                 &none                    &none                       &none
&kp_to ESCAPE 0       &kp Q                    &kp W                    &kp E                        &kp R                 &kp T        &msc SCRL_DOWN   &kp Y      &kp U                  &kp I                 &kp O                    &kp P                       &kp BACKSLASH
&kp BACKSPACE         &mt_h_L_slow LEFT_GUI A  &mt_h_L_slow LEFT_ALT S  &mt_h_L_slow LEFT_CONTROL D  &mt_h_L LEFT_SHIFT F  &kp G        &msc SCRL_LEFT   &kp H      &mt_h_R RIGHT_SHIFT J  &mt_h_R_slow RCTRL K  &mt_h_R_slow LEFT_ALT L  &mt_h_R_slow LEFT_GUI SEMI  &kp APOS
&mt LEFT_SHIFT GRAVE  &kp Z                    &kp X                    &kp C                        &kp V                 &kp B        &msc SCRL_RIGHT  &kp N      &kp M                  &kp COMMA             &kp DOT                  &kp FSLH                    &td_capsw_lock
&kp C_MUTE            &none                    &none                    &mo 3                        &lt 1 TAB             &kp SPACE    &mkp LCLK        &kp ENTER  &lt 2 DELETE           &kp RIGHT_ALT         &none                    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "base";
        };

        lower {
            bindings = <
&trans  &trans                    &trans                    &trans                        &trans                 &trans    &trans  &trans  &trans                  &trans                         &trans                    &trans                    &trans
&trans  &trans                    &trans                    &trans                        &trans                 &trans    &trans  &trans  &kp MINUS               &kp EQUAL                      &kp LEFT_BRACKET          &kp RIGHT_BRACKET         &trans
&trans  &mt_h_L_slow LEFT_GUI N1  &mt_h_L_slow LEFT_ALT N2  &mt_h_L_slow LEFT_CONTROL N3  &mt_h_L LEFT_SHIFT N4  &kp N5    &trans  &kp N6  &mt_h_R RIGHT_SHIFT N7  &mt_h_R_slow RIGHT_CONTROL N8  &mt_h_R_slow LEFT_ALT N9  &mt_h_R_slow LEFT_GUI N0  &trans
&trans  &trans                    &trans                    &trans                        &trans                 &trans    &trans  &trans  &trans                  &trans                         &trans                    &trans                    &trans
&trans  &trans                    &trans                    &trans                        &trans                 &trans    &trans  &trans  &trans                  &trans                         &trans                    &trans
            >;

            label = "lower";
        };

        nav {
            bindings = <
&trans  &trans        &trans        &trans            &trans          &trans    &trans  &trans  &trans    &trans         &trans        &trans     &trans
&trans  &trans        &trans        &trans            &trans          &trans    &trans  &trans  &trans    &trans         &trans        &trans     &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans    &trans  &trans  &kp LEFT  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &trans
&trans  &trans        &trans        &trans            &trans          &trans    &trans  &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &trans
&trans  &trans        &trans        &trans            &trans          &trans    &trans  &trans  &trans    &trans         &trans        &trans
            >;

            display-name = "nav";
        };

        func {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
            >;

            label = "func";
        };

        sys {
            bindings = <
&trans  &trans        &trans        &trans  &trans  &trans         &trans  &trans           &trans           &trans           &trans           &trans           &trans
&trans  &out OUT_USB  &out OUT_BLE  &trans  &trans  &bootloader    &trans  &bootloader      &trans           &trans           &trans           &trans           &trans
&trans  &trans        &trans        &trans  &trans  &trans         &trans  &rgb_ug RGB_ON   &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &trans
&trans  &trans        &trans        &trans  &trans  &trans         &trans  &rgb_ug RGB_OFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &trans
&trans  &trans        &trans        &trans  &trans  &trans         &trans  &trans           &trans           &trans           &trans           &trans
            >;

            label = "sys";
        };

        al_caps_colem {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &kp LS(SEMI)  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        al_capscolem_lower {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans                          &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans                          &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &mt_h_R_slow LEFT_GUI NUMBER_0  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans                          &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        capsw-lower {
            if-layers = <1 5>;
            then-layer = <6>;
        };
    };
};
